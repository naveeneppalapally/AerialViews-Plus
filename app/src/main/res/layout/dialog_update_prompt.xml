<?xml version="1.0" encoding="utf-8"?>
<!-- Option C4: art panel + progress-ready dialog. Left art panel carries the
    version (gradient, giant thin numeral); right side holds release notes;
    footer owns a determinate progress bar so the download phase needs no
    second dialog. Redundant pills from the old layout are gone; version is
    shown once as current → new. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/update_prompt_panel_background"
    android:clipToOutline="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="40"
            android:background="@drawable/update_prompt_art_background"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/update_prompt_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:textColor="@color/update_prompt_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/update_prompt_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:textColor="@color/update_prompt_text_primary"
                android:textSize="64sp" />

            <TextView
                android:id="@+id/update_prompt_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/update_prompt_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/update_prompt_surface_stroke" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="60"
            android:orientation="vertical"
            android:padding="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/update_prompt_highlights_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:textColor="@color/update_prompt_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/update_prompt_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.04"
                    android:textAllCaps="true"
                    android:textColor="@color/update_prompt_text_secondary"
                    android:textSize="11sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/update_prompt_surface_stroke" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/update_prompt_notes_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="16dp"
                android:fadeScrollbars="false"
                android:focusable="false"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/update_prompt_notes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:lineSpacingExtra="10dp"
                    android:textColor="@color/update_prompt_text_primary"
                    android:textSize="14sp" />

            </androidx.core.widget.NestedScrollView>

            <!-- Download progress: hidden until a download starts, so the
                downloading phase lives in this dialog instead of a toast. -->
            <LinearLayout
                android:id="@+id/update_prompt_progress_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/update_prompt_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/update_prompt_text_secondary"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/update_prompt_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="0" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/update_prompt_surface_stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp"
        android:paddingVertical="20dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/update_prompt_download"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="200dp"
            android:background="@drawable/update_prompt_button_primary_background"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="28dp"
            android:textAllCaps="false"
            android:textColor="@color/update_prompt_text_primary"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/update_prompt_later"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="14dp"
            android:minWidth="100dp"
            android:background="@drawable/update_prompt_button_secondary_background"
            android:fontFamily="sans-serif"
            android:paddingHorizontal="28dp"
            android:textAllCaps="false"
            android:textColor="@color/update_prompt_text_primary"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
